# Copy to .env. Both have working defaults -- nothing here is required to run
# the stack locally.

# Postgres. The compose file sets this for the api container; override it to
# point at a database somewhere else.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resource

# CARTO Basemaps -- free, 5M tile requests/month, no account needed:
#   https://carto.com/basemaps/apikey/
#
# NOT a secret: it travels in the tile URL and is readable in devtools. It
# lives here so it is not hardcoded.
#
# Leave it empty and the map falls back to OpenStreetMap tiles inverted in
# CSS: still dark, still correct, just less refined than Dark Matter. With no
# key AND no fallback, CARTO serves tiles stamped "API KEY REQUIRED".
CARTO_KEY=
